# Copy to .env and adjust. Hearth's services and `pnpm hearth` read this file.
# Never commit .env; it's ignored by git.

# The database Hearth uses.
HEARTH_DATABASE_URL=postgres://hearth:CHANGE_ME@localhost:5432/hearth

# Where you open Hearth. With Tailscale Serve this is https://<pc-name>.<tailnet>.ts.net
# Passkeys are bound to this address, so set it before adding your first passkey.
HEARTH_ORIGIN=http://localhost:4400
HEARTH_HOST=127.0.0.1
HEARTH_PORT=4400
# Hearth's address on this PC, which the Windows app's window opens. It defaults to
# http://localhost:<HEARTH_PORT>; it must be an address on this PC.
# HEARTH_LOCAL_ORIGIN=http://localhost:4400

# The built web app (pnpm build:web).
HEARTH_WEB_DIST=apps/web/dist

# Disk-space checks and local backup copies live here.
HEARTH_DATA_DIR=C:\Hearth\data

# Off-site backups with restic through rclone (Google Drive on your Google One plan).
# Leave empty to keep backups on this PC only; `hearth doctor` will remind you.
HEARTH_BACKUP_REPOSITORY=rclone:gdrive:hearth-backups
RESTIC_PASSWORD_FILE=C:\Users\you\.hearth-restic-password

# Jarvis's models (D54). The fast lane, which answers most chat, runs on Sonnet; the deep lane
# runs on the top model. Each setting covers only its own lane.
# HEARTH_JARVIS_MODEL=opus
# HEARTH_JARVIS_FAST_MODEL=sonnet
# Set to 0 to stop Jarvis searching and reading the web.
# HEARTH_JARVIS_WEB=1

# Jarvis and the worker reach Chrome through the server. They find it at HEARTH_HOST and
# HEARTH_PORT; set this only if the server is somewhere else.
# HEARTH_SERVER_URL=http://127.0.0.1:4400

# Hearth opens Chrome when Jarvis needs it and it's closed. As a Windows service it runs the
# "Hearth Chrome" task from install.ps1; otherwise it starts Chrome itself. Set to off to open
# Chrome yourself. HEARTH_CHROME_PATH and HEARTH_CHROME_PROFILE (like "Profile 1") apply when
# Hearth starts Chrome itself.
# HEARTH_CHROME_LAUNCH=off
# HEARTH_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# HEARTH_CHROME_PROFILE=Default

# Google (Calendar now, Gmail later): an OAuth client of type "Desktop app" from Google Cloud
# Console, with the Calendar and Gmail APIs enabled and the consent screen published. Connect an
# account from Settings in a browser on this PC.
# HEARTH_GOOGLE_CLIENT_ID=
# HEARTH_GOOGLE_CLIENT_SECRET=
