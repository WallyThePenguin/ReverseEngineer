<!-- WinSW v2 service definition. install.ps1 fills in {{NODE}} and {{ROOT}}. -->
<service>
  <id>hearth-jarvis</id>
  <name>Hearth Jarvis</name>
  <description>Jarvis, Hearth's agent. Runs as your account so it can use your Claude login.</description>
  <executable>{{NODE}}</executable>
  <arguments>--env-file-if-exists="{{ROOT}}\.env" "{{ROOT}}\apps\cli\src\main.ts" jarvis</arguments>
  <workingdirectory>{{ROOT}}</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="2 min"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>20sec</stoptimeout>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
